GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=your_github_username

# Comma-separated hex colors (e.g., bg, level1, level2, level3, level4)
# Default GitHub Green: #ebedf0,#9be9a8,#40c463,#30a14e,#216e39
# Example Dracula: #282a36,#44475a,#6272a4,#bd93f9,#ff79c6
COLOR_THEME=#ebedf0,#9be9a8,#40c463,#30a14e,#216e39
