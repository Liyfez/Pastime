GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_personal_access_token

# Comma-separated hex colors for Light Mode (bg, level1, level2, level3, level4)
LIGHT_THEME=#ebedf0,#9be9a8,#40c463,#30a14e,#216e39

# Comma-separated hex colors for Dark Mode (bg, level1, level2, level3, level4)
DARK_THEME=#161b22,#0e4429,#006d32,#26a641,#39d353
